<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{ url }}/assets/css/default.css" >
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <title>{{ title }} — API آماده برای تست و نمونه‌سازی</title>
  <meta
    name="description"
    content="با JSON Holder به داده‌های نمونه و API آماده برای تست، تمرین و ساخت سریع نمونه‌های اولیه دسترسی داشته باشید."/>
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="{{ url }}" />

  <!-- Open Graph: نمایش هنگام اشتراک‌گذاری در شبکه‌های اجتماعی -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fa_IR" />
  <meta property="og:site_name" content="JSON Holder" />
  <meta
    property="og:title"
    content="JSON Holder — API آماده برای تست و نمونه‌سازی"
  />
  <meta
    property="og:description"
    content="یک API ساده و آماده با داده‌های JSON برای تست، تمرین و نمونه‌سازی."
  />
  <meta property="og:url" content="{{ url }}" />
  <meta
    property="og:image"
    content="{{ url }}/assets/image/cover.jpg"
  />
  <meta property="og:image:alt" content="پوستر نئونی JSON Holder" />

  <!-- Twitter/X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta
    name="twitter:title"
    content="JSON Holder — API آماده برای تست و نمونه‌سازی"
  />
  <meta
    name="twitter:description"
    content="یک API ساده و آماده با داده‌های JSON برای تست، تمرین و نمونه‌سازی."
  />
  <meta
    name="twitter:image"
    content="{{ url }}/assets/image/cover.jpg"
  />
</head>
<body>
  <div class="bg-effects"></div>
  <div class="grid-pattern"></div>

  <header>
    <div class="container">
      <div class="badge">API آزمایشی • آماده استفاده</div>
      <h1>JSON Placeholder پارسی</h1>
      <p class="hero-desc">
        یک REST API جعلی و رایگان با داده‌های پارسی برای تست، پروتوتایپ و یادگیری توسعه فرانت‌اند و موبایل
      </p>
      <div class="base-url">
        <span id="baseUrl">{{ url }}/api/v1</span>
        <button onclick="copyText('{{ url }}/api/v1', this)" title="کپی کردن">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <!-- About -->
    <section>
      <div class="container">
        <h2 class="section-title"><span>چیست؟</span></h2>
        <p class="section-sub">معرفی کوتاه سرویس</p>

        <div class="about-card">
          <p>
            <strong style="color: var(--text);">JSON Placeholder پارسی</strong> یک سرویس REST API جعلی (Fake) است که برای توسعه‌دهندگان فرانت‌اند، موبایل و بک‌اند طراحی شده.
            با استفاده از این API می‌توانید بدون نیاز به راه‌اندازی سرور واقعی، داده‌های پارسی دریافت کنید و منطق برنامه خود را تست نمایید.
          </p>
          <p>
            این سرویس از استانداردهای RESTful پیروی می‌کند و داده‌هایی مانند کاربران، محصولات، دسته‌بندی‌ها، نوشته‌ها و تسک‌ها را در اختیار شما قرار می‌دهد.
            تمام پاسخ‌ها به صورت JSON برگردانده می‌شوند و برای توسعه سریع، آموزش و ساخت پروتوتایپ ایده‌آل است.
          </p>

          <div class="features">
            <div class="feature">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              داده‌های کاملاً پارسی
            </div>
            <div class="feature">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              پشتیبانی از GET
            </div>
            <div class="feature">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              بدون نیاز به احراز هویت
            </div>
            <div class="feature">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              آماده برای تست سریع
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Endpoints -->
    <section>
      <div class="container">
        <h2 class="section-title"><span>اندپوینت‌ها</span></h2>
        <p class="section-sub">لیست کامل موجودیت‌های پشتیبانی‌شده همراه با آدرس‌های قابل کپی</p>

        <div class="entities">

        <!-- Users -->
                  <article class="entity-card">
                    <div class="entity-header">
                      <div class="entity-name">
                        <div class="icon">👤</div>
                        کاربران
                      </div>
                      <span class="entity-tag">user</span>
                    </div>
                    <p class="entity-desc">اطلاعات کاربران سیستم. برای دسترسی به یک کاربر خاص از شناسه عددی (id) استفاده می‌شود.</p>

                    <div class="endpoints">
                      <div class="endpoint">
                        <div class="endpoint-label">فهرست کاربران</div>
                        <div class="endpoint-row">
                          <span class="method">GET</span>
                          <span class="url">{{ url }}/api/v1/users</span>
                          <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/users', this)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            کپی
                          </button>
                        </div>
                      </div>

                      <div class="endpoint">
                        <div class="endpoint-label">نمایش یک کاربر (با id)</div>
                        <div class="endpoint-row">
                          <span class="method">GET</span>
                          <span class="url">{{ url }}/api/v1/users/[id]</span>
                          <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/users/1', this)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            کپی
                          </button>
                        </div>
                      </div>
                    </div>
                  </article>

                  <!-- Todos -->
                  <article class="entity-card">
                    <div class="entity-header">
                      <div class="entity-name">
                        <div class="icon">✅</div>
                        تسک‌ها (Todo)
                      </div>
                      <span class="entity-tag">todo</span>
                    </div>
                    <p class="entity-desc">لیست کارهای انجام‌دادنی. این موجودیت فقط فهرست کامل را پشتیبانی می‌کند و نمایش تکی ندارد.</p>

                    <div class="endpoints">
                      <div class="endpoint">
                        <div class="endpoint-label">فهرست تسک‌ها</div>
                        <div class="endpoint-row">
                          <span class="method">GET</span>
                          <span class="url">{{ url }}/api/v1/todos</span>
                          <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/todos', this)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            کپی
                          </button>
                        </div>
                      </div>
                    </div>
                  </article>

          <!-- Categories -->
          <article class="entity-card">
            <div class="entity-header">
              <div class="entity-name">
                <div class="icon">📂</div>
                دسته‌بندی‌ها
              </div>
              <span class="entity-tag">category</span>
            </div>
            <p class="entity-desc">در این بخش دسته‌بندی محصولات نمایش داده می‌شود. می‌توانید لیست کامل یا یک دسته‌بندی خاص را با استفاده از slug دریافت کنید.</p>

            <div class="endpoints">
              <div class="endpoint">
                <div class="endpoint-label">فهرست دسته‌بندی‌ها</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/categories</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/categories', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
              </div>

              <div class="endpoint">
                <div class="endpoint-label">نمایش یک دسته به تنهایی</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/categories/[slug]</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/categories/mobile-tablet', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
{#                <div class="example">مثال: <code>{{ url }}/api/v1/categories/mobile-tablet</code></div>#}
              </div>
            </div>
          </article>

          <!-- Products -->
          <article class="entity-card">
            <div class="entity-header">
              <div class="entity-name">
                <div class="icon">🛍️</div>
                محصولات
              </div>
              <span class="entity-tag">product</span>
            </div>
            <p class="entity-desc">لیست محصولات به همراه جزئیات هر محصول. هر محصول دارای دیدگاه (نظرات) نیز می‌باشد و با slug قابل دسترسی است.</p>

            <div class="endpoints">
              <div class="endpoint">
                <div class="endpoint-label">فهرست محصولات</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/products</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/products', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
              </div>

              <div class="endpoint">
                <div class="endpoint-label">نمایش یک محصول</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/products/[slug]</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/products/mobile-accessories-vijeh5966', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
{#                <div class="example">مثال: <code>{{ url }}/api/v1/products/iphone-15-pro</code></div>#}
              </div>
            </div>
          </article>

          <!-- Posts -->
          <article class="entity-card">
            <div class="entity-header">
              <div class="entity-name">
                <div class="icon">📝</div>
                نوشته‌ها
              </div>
              <span class="entity-tag">post</span>
            </div>
            <p class="entity-desc">مجموعه نوشته‌ها و مقالات. هر نوشته با slug قابل دسترسی است و دارای دیدگاه (نظرات کاربران) می‌باشد.</p>

            <div class="endpoints">
              <div class="endpoint">
                <div class="endpoint-label">فهرست نوشته‌ها</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/posts</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/posts', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
              </div>

              <div class="endpoint">
                <div class="endpoint-label">نمایش یک نوشته</div>
                <div class="endpoint-row">
                  <span class="method">GET</span>
                  <span class="url">{{ url }}/api/v1/posts/[slug]</span>
                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/posts/tarik7678-parastoo8114', this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    کپی
                  </button>
                </div>
{#                <div class="example">مثال: <code>{{ url }}/api/v1/posts/how-to-learn-js</code></div>#}
              </div>

{#              <div class="endpoint">#}
{#                <div class="endpoint-label">دیدگاه‌های یک نوشته</div>#}
{#                <div class="endpoint-row">#}
{#                  <span class="method">GET</span>#}
{#                  <span class="url">{{ url }}/api/v1/posts/[slug]/comments</span>#}
{#                  <button class="copy-btn" onclick="copyText('{{ url }}/api/v1/posts/[slug]/comments', this)">#}
{#                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>#}
{#                    کپی#}
{#                  </button>#}
{#                </div>#}
{#              </div>#}
            </div>
          </article>

        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>
        ساخته شده با 💜 برای توسعه‌دهندگان پارسی‌زبان
      </p>
      {% include "partials/dev/performance.j2" %}
    </div>
  </footer>

  <div class="toast" id="toast">کپی شد!</div>

  <script>
    function copyText(text, btn) {
      navigator.clipboard.writeText(text).then(() => {
        // Update button
        const original = btn.innerHTML;
        btn.classList.add('copied');
        btn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          کپی شد
        `;

        // Show toast
        const toast = document.getElementById('toast');
        toast.classList.add('show');

        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = original;
          toast.classList.remove('show');
        }, 1800);
      }).catch(err => {
        console.error('خطا در کپی:', err);
      });
    }
  </script>
</body>
</html>
